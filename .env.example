IG_USER_ID=your_instagram_user_id
IG_ACCESS_TOKEN=your_long_lived_instagram_token

# Each enabled channel requires its own OAuth credentials.
YT1_CLIENT_ID=your_client_id.apps.googleusercontent.com
YT1_CLIENT_SECRET=your_client_secret
YT1_REFRESH_TOKEN=your_refresh_token
YT2_CLIENT_ID=
YT2_CLIENT_SECRET=
YT2_REFRESH_TOKEN=

YOUTUBE_PRIVACY_STATUS=public
SKIPPED_RETRY_HOURS=24
TEMP_DIR=data/temp
HISTORY_DIR=data/channel_history
