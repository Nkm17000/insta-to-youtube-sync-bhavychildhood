# Instagram
IG_USER_ID=your_instagram_user_id
IG_ACCESS_TOKEN=your_long_lived_token

# Channel 1 - Old Gmail bhavychildhood
YT1_CLIENT_ID=xxx.apps.googleusercontent.com
YT1_CLIENT_SECRET=GOCSPX-xxx
YT1_REFRESH_TOKEN=1//0xxx
YT1_ENABLED=true

# Channel 2 - New Gmail (different Gmail = separate 15/day limit)
YT2_CLIENT_ID=xxx.apps.googleusercontent.com
YT2_CLIENT_SECRET=GOCSPX-xxx
YT2_REFRESH_TOKEN=1//0xxx
YT2_ENABLED=true

# Channel 3 - Optional
YT3_CLIENT_ID=
YT3_CLIENT_SECRET=
YT3_REFRESH_TOKEN=
YT3_ENABLED=false

# Settings
YOUTUBE_PLAYLIST_TITLE=bhavychildhood
YOUTUBE_PLAYLIST_DESCRIPTION=All videos from Instagram @bhavychildhood
YOUTUBE_PRIVACY_STATUS=public
VIDEOS_PER_RUN=1
