# Instagram Graph API (professional Instagram account connected to a Facebook app)
IG_USER_ID=your_instagram_professional_account_id
IG_ACCESS_TOKEN=your_instagram_graph_api_access_token
# Keep this API version current for your Meta app. Example only:
IG_GRAPH_API_VERSION=v23.0
# auto tries the alternate Graph API host once on path error 2500. You may set explicitly:
# IG_API_MODE=facebook_login  (graph.facebook.com)
# IG_API_MODE=instagram_login (graph.instagram.com)
IG_API_MODE=auto

# The env_prefix values in config/channels.json determine which credentials each channel uses.
YT1_CLIENT_ID=
YT1_CLIENT_SECRET=
YT1_REFRESH_TOKEN=

YT2_CLIENT_ID=
YT2_CLIENT_SECRET=
YT2_REFRESH_TOKEN=

# Optional global defaults; per-channel config values take precedence.
YOUTUBE_PRIVACY_STATUS=public
SKIPPED_RETRY_HOURS=24
MAX_ITEMS_PER_RUN=100
DOWNLOAD_DIR=downloads

# Convert Instagram still images into silent MP4 videos of this duration (3-60 seconds).
IMAGE_VIDEO_DURATION_SECONDS=8
# Maximum upload attempts per channel per run; skipped/non-eligible items do not consume it.
MAX_ITEMS_PER_RUN=20
